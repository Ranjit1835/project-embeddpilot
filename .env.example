# Copy to .env and fill in ONE provider. Never commit the filled-in file —
# .gitignore already covers .env* and *.key.

# ---------------------------------------------------------------- provider
# gemini | groq | nvidia
EMBEDDPILOT_PROVIDER=gemini

# Gemini (free tier is enough for testing) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-3.6-flash is the current free flash model. 2.0/2.5-flash are RETIRED.
GEMINI_MODEL=gemini-3.6-flash
# gemini-3.6-flash is a thinking model: reasoning shares the output budget, so
# 8000 truncates the JSON mid-response. 24000 is the tested value.
GEMINI_MAX_TOKENS=24000

# Groq — https://console.groq.com/keys
# GROQ_API_KEY=

# NVIDIA — https://build.nvidia.com
# NOTE: openai/gpt-oss-120b was retired 2026-09-03 and now returns 410.
# NVIDIA_API_KEY=
# NVIDIA_MODEL=

# --------------------------------------------------------------- toolchain
# Only needed if the tools are not on PATH. `/api/v2/capabilities` reports what
# was actually found, so check there before setting these.
# EMBEDDPILOT_RENODE=/opt/renode/renode
# EMBEDDPILOT_ARM_GCC=/usr/bin/arm-none-eabi-gcc
