{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "embeddpilot/register-map.schema.json",
  "title": "Canonical extracted register map (V1.5 ingestion output)",
  "type": "object",
  "required": ["peripheral", "chip", "registers", "extraction_confidence", "source_pages"],
  "properties": {
    "peripheral": { "type": "string" },
    "chip": { "type": "string" },
    "base_address": {
      "type": ["string", "null"],
      "pattern": "^0x[0-9A-Fa-f]+$"
    },
    "access_pattern": {
      "description": "V1.9: how the register set is addressed. 'pointer' = a pointer register selects the data register (write the pointer byte, then read/write N bytes) — TMP100/LM75B-class parts. 'direct' = the offset is used as-is. Absent is treated as 'direct'.",
      "type": "string",
      "enum": ["direct", "pointer"]
    },
    "readout": {
      "description": "V1.9 item 3: fixed-readout device with NO register map (TMP125). Clock out a bit_width-bit word; the value is bits [value_msb:value_lsb], optionally signed two's complement, scaled by lsb_weight. These are the ground truth the generated shift/mask/scale is cross-checked against.",
      "type": "object",
      "required": ["bit_width", "value_msb", "value_lsb", "signed", "lsb_weight"],
      "properties": {
        "bit_width": { "type": "integer", "minimum": 1 },
        "value_msb": { "type": "integer", "minimum": 0 },
        "value_lsb": { "type": "integer", "minimum": 0 },
        "signed": { "type": "boolean" },
        "lsb_weight": { "type": "number" },
        "unit": { "type": "string" },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "source_pages": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
      }
    },
    "registers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "offset", "source_pages"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "offset": { "type": "string", "pattern": "^0x[0-9A-Fa-f]+$" },
          "reset_value": { "type": ["string", "null"], "pattern": "^0x[0-9A-Fa-f]+$" },
          "access": { "type": ["string", "null"], "enum": ["RW", "RO", "WO", null] },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "bits"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "bits": { "type": "string", "pattern": "^\\[\\d+:\\d+\\]$" },
                "description": { "type": "string" }
              }
            }
          },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "source_pages": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "opcode", "source_pages"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "opcode": { "type": "string", "pattern": "^0x[0-9A-Fa-f]+$" },
          "description": { "type": "string" },
          "address_bytes": { "type": ["integer", "null"], "minimum": 0 },
          "dummy_cycles": { "type": ["integer", "null"], "minimum": 0 },
          "data_direction": { "type": ["string", "null"], "enum": ["read", "write", "none", null] },
          "source_pages": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "extraction_confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "source_pages": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "low_confidence_pages": { "type": "array", "items": { "type": "integer" } },
    "detected": {
      "description": "V1.6: metadata detected from the datasheet front matter. Suggestions only — each carries confidence + source_pages evidence.",
      "type": "object",
      "properties": {
        "chip": { "$ref": "#/definitions/detectedValue" },
        "vendor": { "$ref": "#/definitions/detectedValue" },
        "shape_hint": { "$ref": "#/definitions/detectedValue" },
        "interfaces": { "type": "array", "items": { "$ref": "#/definitions/detectedValue" } }
      }
    },
    "provenance": {
      "description": "V1.6: origin of each input field. 'user' or 'detected' are generatable; 'detected_unconfirmed' or null are blocked.",
      "type": "object",
      "properties": {
        "chip": { "type": ["string", "null"], "enum": ["user", "detected", "detected_unconfirmed", null] },
        "peripheral": { "type": ["string", "null"], "enum": ["user", "detected", "detected_unconfirmed", null] }
      }
    }
  },
  "definitions": {
    "detectedValue": {
      "type": "object",
      "required": ["value", "confidence", "source_pages"],
      "properties": {
        "value": { "type": "string" },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "source_pages": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
      }
    }
  }
}
